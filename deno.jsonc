  "tasks": {
    "run": {
      "command": "cd dist/deno/src && DENO_TRACE_PERMISSIONS=true deno run --allow-run=git,rg --deny-run=open,deno --allow-env --allow-ffi --allow-sys --allow-read --allow-write=../../data,../../data/config,../../data/state,../../data/cache/ --allow-net=models.dev:443,0.0.0.0:4097,opencode.ai:443  --config ../../../deno.jsonc --sloppy-imports ./index-deno.js --log-level DEBUG  --print-logs --port 4097 --hostname 0.0.0.0"
    }
  },
  "nodeModulesDir": "auto",
  "allowScripts": {
  }
}
